{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "receipts-web",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "receipts.web:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "extension-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "extension",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
