# --- Discord (free: https://discord.com/developers/applications) ---
# Enable "Message Content" and "Server Members" intents on the bot.
DISCORD_TOKEN=
VERIFIED_ROLE_NAME=Verified Capper
PICK_CHANNEL_KEYWORDS=moneyline,ml-picks
PUBLIC_URL=http://localhost:8000

# --- Verification rules (real defaults: one full month) ---
VERIFY_WINDOW_DAYS=30
VERIFY_MIN_PICKS=15
VERIFY_MIN_DAYS=10
VERIFY_MAX_EDITS=0
MAX_UNITS=10

# --- Demo window (uncomment for the hackathon demo; clearly labelled "demo" in the UI) ---
# DEMO_MODE=true
# VERIFY_WINDOW_DAYS=4
# VERIFY_MIN_PICKS=8
# VERIFY_MIN_DAYS=3

# --- Gemini Prediction Markets (public, no key) ---
GEMINI_API_BASE=https://api.gemini.com
# Placeholder until the public market URL format is confirmed with the Gemini team. {slug} and {ticker} are filled in.
GEMINI_MARKET_URL=https://www.gemini.com/predictions/{slug}

# --- Price comparison for verified cappers (public, no key) ---
SHOW_OTHER_VENUES=true

# --- Arc testnet (free USDC gas from https://faucet.circle.com) ---
# Leave blank to lock picks "unanchored" (hash stored locally, anchored later).
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_PRIVATE_KEY=
PICK_REGISTRY_ADDRESS=
ARC_EXPLORER_URL=https://testnet.arcscan.app
